<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="trash_TSPU_GUI.MainWindow"
        Title="trash_TSPU_GUI">
    <StackPanel>
    <CheckBox x:Name="trash" Content="trash (Включен)" IsChecked="True" />
    <CheckBox x:Name="trashhttp" Content="trashhttp (Включен)" IsChecked="True" />
    <CheckBox x:Name="dnstrash" Content="dnstrash (Включен)" IsChecked="True" />
    <StackPanel Orientation="Horizontal">
    <Button x:Name="Start" Content="Start" Click="OnStartClick" />
    <Button x:Name="Stop" Content="Stop" Click="offStartClick" />
    </StackPanel>
    <TextBlock x:Name="log" />
    </StackPanel>
</Window>
